[Unit]
Description=智能问答平台 (QA Chat with RAG)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/qa-chat
ExecStart=/opt/qa-chat/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# 环境变量（与 .env 文件二选一）
EnvironmentFile=/opt/qa-chat/.env

[Install]
WantedBy=multi-user.target
